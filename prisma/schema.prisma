generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                     String       @id @default(cuid())
  email                                  String       @unique
  name                                   String
  role                                   String       @default("INSPECTOR")
  department                             String       @default("Quality Assurance")
  status                                 String       @default("ACTIVE")
  avatar                                 String?
  createdAt                              DateTime     @default(now())
  updatedAt                              DateTime     @updatedAt
  auditLogs                              AuditLog[]
  inspections                            Inspection[]
  Inspection_Inspection_reviewerIdToUser Inspection[] @relation("Inspection_reviewerIdToUser")
}

model ProductionLine {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  facility    String       @default("Plant 1 — Detroit")
  productType String
  shift       String       @default("Day")
  status      String       @default("RUNNING")
  throughput  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  inspections Inspection[]
}

model Inspection {
  id                               String          @id @default(cuid())
  inspectionCode                   String          @unique
  partId                           String
  partName                         String
  partNumber                       String
  productionLineId                 String?
  inspectorId                      String?
  modelUsed                        String          @default("YOLOv11-Defect")
  imageUrl                         String?
  thumbnail                        String?
  status                           String          @default("PENDING")
  severity                         String          @default("NONE")
  confidence                       Float           @default(0)
  defectCount                      Int             @default(0)
  processingMs                     Int             @default(0)
  inferenceDevice                  String          @default("GPU-A100")
  notes                            String?
  rawAnalysis                      String?
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime        @updatedAt
  decisionReason                   String?
  inferenceStatus                  String          @default("COMPLETED")
  originalStatus                   String?
  originalSeverity                 String?
  imageSizeBytes                   Int             @default(0)
  reviewStatus                     String          @default("PENDING")
  reviewerId                       String?
  reviewedAt                       DateTime?
  reviewDecision                   String?
  reviewNotes                      String?
  defects                          Defect[]
  inspector                        User?           @relation(fields: [inspectorId], references: [id])
  productionLine                   ProductionLine? @relation(fields: [productionLineId], references: [id])
  User_Inspection_reviewerIdToUser User?           @relation("Inspection_reviewerIdToUser", fields: [reviewerId], references: [id])

  @@index([createdAt])
  @@index([reviewStatus])
  @@index([status])
}

model Defect {
  id           String     @id @default(cuid())
  inspectionId String
  type         String
  severity     String
  confidence   Float
  bboxX        Float      @default(0)
  bboxY        Float      @default(0)
  bboxW        Float      @default(0)
  bboxH        Float      @default(0)
  location     String?
  description  String?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String   @default("system")
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String   @default("—")
  severity   String   @default("INFO")
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([timestamp])
}

model ModelMetric {
  id            String   @id @default(cuid())
  modelName     String
  version       String
  map50         Float
  map5095       Float
  precision     Float
  recall        Float
  f1            Float
  inferenceMs   Float
  paramsMillion Float
  dataset       String   @default("IndustrialDefect-12k")
  status        String   @default("PRODUCTION")
  evaluatedAt   DateTime @default(now())

  @@index([modelName])
}

model SystemConfig {
  id          String   @id
  key         String   @unique
  value       String
  category    String   @default("inspection")
  description String?
  updatedAt   DateTime
  updatedBy   String?
}
